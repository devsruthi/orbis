# Server only. Never expose these to the browser, Tauri, or Android.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Inngest (server-side only). Used by the local Dev Server and production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 when running the Inngest Dev Server locally.
INNGEST_DEV=1

# JSON persistence root (defaults to ./data)
ORBIS_DATA_DIR=./data

# Empty means same-origin /api (web). For Tauri/Android, set the deployed
# Orbis backend origin, for example https://orbis.example
NEXT_PUBLIC_API_BASE_URL=

# No speech-provider keys. STT/TTS use the browser or Android WebView
# Web Speech APIs. Do not add NEXT_PUBLIC_* speech secrets.
# Defaults already include Tauri and local development origins.
# Do not use Access-Control-Allow-Origin: *.
ORBIS_CORS_ORIGINS=
