# Server only. Never expose these to the browser, Tauri, or Android.
ANTHROPIC_API_KEY=

# Unused until later stages.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# JSON persistence root (defaults to ./data)
ORBIS_DATA_DIR=./data

# Empty means same-origin /api. Set this when a Tauri client is added later.
NEXT_PUBLIC_API_BASE_URL=
# Inngest (server-side only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# Auth.js (Google login)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=